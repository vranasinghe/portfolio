
# ─────────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES — portfolio
#
#  Copy this file to .env.local and fill in the values below.
#  Never commit .env.local to version control.
#
#    cp .env.example .env.local
# ─────────────────────────────────────────────────────────────


# Contact uses the server-only Resend configuration below.
# Legacy Web3Forms configuration is no longer used.


# ── Contact Form (Resend) ─────────────────────────────────────
# Server-only. Get a key at https://resend.com/api-keys
# Messages go only to CONTACT_TO_EMAIL; visitor confirmations are disabled.
RESEND_API_KEY=
# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=
# Optional: sender on a verified domain. Defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=


# ── WhatsApp Integration ──────────────────────────────────────
# Your WhatsApp number in international format (no spaces or dashes).
# Example: +94706827870  (Sri Lanka)  |  +14155552671  (USA)
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ── Feature Flags ─────────────────────────────────────────────
# Reviews: clients submit through invite links at /review. Each review is saved to
# Supabase and shown right away; a copy is emailed to CONTACT_TO_EMAIL.
# Shown by default between Certifications and Contact.
# Set to 'false' to hide the section.
NEXT_PUBLIC_SHOW_REVIEWS=true

# Server-only Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# GitHub contribution activity (server only)
# Token must be authorized for GitHub GraphQL contribution-calendar reads.
# Never prefix this token with NEXT_PUBLIC_. Missing token shows unavailable.
GITHUB_TOKEN=
GITHUB_USERNAME=vranasinghe

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEW_INVITE_SECRET=
# Use a long password; never commit it.
ADMIN_PASSWORD=

# Client review storage (server only). Supabase → Project Settings → API.
# Use the project URL and the secret key (sb_secret_...), never the publishable key.
# Create the table with supabase/reviews.sql. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

