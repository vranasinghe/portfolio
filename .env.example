
# ─────────────────────────────────────────────────────────────
#  ENVIRONMENT VARIABLES — portfolio
#
#  Copy this file to .env.local and fill in the values below.
#  Never commit .env.local to version control.
#
#    cp .env.example .env.local
# ─────────────────────────────────────────────────────────────


# ── Contact Form ──────────────────────────────────────────────
# Web3Forms is a free, serverless form backend.
# Register and get your free Access Key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=


# ── Contact Form (Resend) ─────────────────────────────────────
# Server-only. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=
# Optional: sender on a verified domain. Defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=


# ── WhatsApp Integration ──────────────────────────────────────
# Your WhatsApp number in international format (no spaces or dashes).
# Example: +94706827870  (Sri Lanka)  |  +14155552671  (USA)
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ── Feature Flags ─────────────────────────────────────────────
# Set to 'true' to display the Reviews & Testimonials section.
# Set to 'false' to hide it (useful while you collect initial reviews).
NEXT_PUBLIC_SHOW_REVIEWS=false
